# Vercel Production Environment Variables
# Set these in Vercel Dashboard → Project → Settings → Environment Variables

# Your Railway/Render backend URL (NO trailing slash, include /api/v1)
VITE_API_URL=https://your-backend.railway.app/api/v1

# Your Railway/Render backend URL for Socket.io (NO trailing slash, NO /api/v1)
VITE_SOCKET_URL=https://your-backend.railway.app

# Supabase (same values as backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: WebRTC TURN server
# VITE_TURN_URL=turn:your-turn-server.com:3478
# VITE_TURN_USER=username
# VITE_TURN_PASS=password
